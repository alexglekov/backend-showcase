{
  "name": "one-vs-one-worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/one-vs-one-worker/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/one-vs-one-worker",
        "main": "apps/one-vs-one-worker/src/main.ts",
        "tsConfig": "apps/one-vs-one-worker/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/**/*.proto",
            "input": "libs/contracts/src",
            "output": "grpc"
          }
        ],
        "isolatedConfig": true,
        "webpackConfig": "apps/one-vs-one-worker/webpack.config.js"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "one-vs-one-worker:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "one-vs-one-worker:build:development"
        },
        "production": {
          "buildTarget": "one-vs-one-worker:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/one-vs-one-worker/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/one-vs-one-worker/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  },
  "tags": []
}
