<!DOCTYPE html>
<html>
  <head>
    <link href="https://fonts.cdnfonts.com/css/poppins" rel="stylesheet">           
    <style>        
      .outer {
        display: table;
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
      }

      .middle {
        display: table-cell;
        vertical-align: middle;
      }

      .inner {
        margin-left: auto;
        margin-right: auto;
        width: 400px;
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .header {
        font-family: Poppins, sans-serif;
        font-weight: 600;
        margin: 0;
      }

      p {
        font-family: Poppins, sans-serif;
        margin: 0;
      }

      .login-code__text {
        color: gray;
        font-size: 14px;
      }

      .login-code__code {
        font-size: 48px;
        font-weight: 600;
        margin: 0;
      }

      .code-expires {
        font-size: 14px;
      }

      .redirect-link__text {
        font-size: 14px;
        margin-bottom: 4px;
      }

      .redirect-link__link {
        font-family: Poppins, sans-serif;
      }

      .team-title {
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="outer">
        <div class="middle">
          <div class="inner">
            <h1 class="header">Log into XYRO</h1>
            <div>
              <p class="login-code__text">Login code</p>
              <p class="login-code__code">{{ token }}</p>
            </div>
            <p class="code-expires">This code expires in 1 hour.</p>
            <div>
              <p class="redirect-link__text">You can also click this link:</p>
              <a href="{{ link }}" target="_blank" class="redirect-link__link">https://dev.xyro.io/</a>
            </div>
            <p class="team-title">- XYRO Team</p>
        </div>
      </div>
    </main>
  </body>
</html>