{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "importHelpers": true,
    "module": "es2020",
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@xyro/api-gateway": ["apps/api-gateway/src"],
      "@xyro/contracts/analytics": ["libs/contracts/src/analytics"],
      "@xyro/contracts/bulls-eye": ["libs/contracts/src/bulls-eye"],
      "@xyro/contracts/candles": ["libs/contracts/src/candles"],
      "@xyro/contracts/twitter": ["libs/contracts/src/twitter"],
      "@xyro/contracts/ledger": ["libs/contracts/src/ledger"],
      "@xyro/contracts/messenger": ["libs/contracts/src/messenger"],
      "@xyro/contracts/notifications": ["libs/contracts/src/notifications"],
      "@xyro/contracts/one-vs-one": ["libs/contracts/src/one-vs-one"],
      "@xyro/contracts/prices": ["libs/contracts/src/prices"],
      "@xyro/contracts/setups": ["libs/contracts/src/setups"],
      "@xyro/contracts/up-down": ["libs/contracts/src/up-down"],
      "@xyro/contracts/users": ["libs/contracts/src/users"],
      "@xyro/contracts/x1000": ["libs/contracts/src/x1000"],
      "@xyro/core": ["libs/core/src/index.ts"],
      "@xyro/libs/columnDb": ["libs/columnDb/src/index.ts"],
      "@xyro/libs/events": ["libs/events/src/index.ts"],
      "@xyro/libs/exceptions": ["libs/exceptions/src/index.ts"],
      "@xyro/libs/graphql": ["libs/graphql/src/index.ts"],
      "@xyro/libs/ledger": ["libs/ledger-package/src/index.ts"],
      "@xyro/libs/logger": ["libs/logger/src/index.ts"],
      "@xyro/libs/mailer": ["libs/mailer/src/index.ts"],
      "@xyro/libs/redis": ["libs/redis/src"],
      "@xyro/libs/scheduler": ["libs/scheduler/src"],
      "@xyro/libs/storage": ["libs/storage/src"],
      "@xyro/libs/utils": ["libs/utils/src"],
      "@xyro/prices": ["apps/prices/src"],
      "@xyro/users": ["apps/users/src"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
